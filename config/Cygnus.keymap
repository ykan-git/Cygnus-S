#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        CaptureMovie: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(NUMBER_1))>;
            label = "NEW_MACRO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W             &kp E         &kp R             &kp T                                             &kp Y              &kp U  &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F             &kp G        &mo 6                 &kp BACKSPACE  &kp H              &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V             &kp B        &kp LEFT_COMMAND      &kp ENTER      &kp N              &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SEMICOLON
&kp TAB             &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &lt 1 SPACE  &lt 2 BACKSPACE       &lt 3 ENTER    &kp RIGHT_COMMAND                             &kp ESCAPE
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        Symbol {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR            &kp PERCENT                      &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LA(S)        &kp LC(S)    &kp LC(O)  &kp LS(LG(NUMBER_1))  &trans       &trans      &trans  &kp BSLH   &kp EQUAL      &kp LBKT      &kp RBKT              &kp BSLH
&trans           &trans       &trans     &trans                &trans       &trans      &trans  &trans     &trans         &kp MINUS     &kp SEMI              &kp SQT
&trans           &trans       &trans     &trans                &trans       &trans      &trans  &trans                                                        &kp ESC
            >;
        };

        Number {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                       &kp N1  &kp N2  &kp N3  &kp EQUAL  &kp ASTRK
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans      &trans  &kp N4  &kp N5  &kp N6  &kp PLUS   &kp SLASH
&kp F11  &kp F12  &trans  &trans  &trans   &trans      &trans  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp PERIOD
&trans   &trans   &trans  &trans  &trans   &trans      &trans  &kp N0                             &kp COMMA
            >;
        };

        Move {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp N1  &kp N2          &kp UP_ARROW    &kp N3           &kp N4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp N5  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp N9
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp N0  &kp N1          &kp DOWN_ARROW  &kp N3           &kp N4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &kp N5
            >;
        };

        MOUSE {
            bindings = <
&trans  &kp LC(PAGE_DOWN)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                      &trans    &kp LC(PAGE_UP)  &kp LG(PAGE_DOWN)  &trans    &trans
&trans  &lt 7 SPACE        &mkp LCLK        &mkp RCLK          &mkp MCLK  &trans      &trans  &mkp MB4  &mkp LCLK        &mkp RCLK          &mkp MB5  &trans
&trans  &trans             &trans           &trans             &trans     &trans      &trans  &trans    &mkp MCLK        &mkp MCLK          &trans    &trans
&trans  &trans             &trans           &trans             &trans     &trans      &trans  &trans                                                  &trans
            >;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        Settings {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

        NUMSIGN {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3     &kp NUMBER_4     &kp N5                            &kp NUMBER_6  &kp N7                &kp N8            &kp N9             &kp N0
&trans        &kp ESCAPE       &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans      &trans  &kp EQUAL     &kp TILDE             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &trans      &trans  &kp SLASH     &kp NON_US_BACKSLASH  &kp SEMICOLON     &kp SINGLE_QUOTE   &trans
&trans        &trans           &trans           &trans           &trans        &trans      &trans  &trans                                                                   &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                      &kp F6  &kp F7              &kp F8          &kp F9               &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_ARROW      &kp UP_ARROW    &kp RIGHT_ARROW      &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(LEFT_ARROW)  &kp DOWN_ARROW  &kp LG(RIGHT_ARROW)  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                           &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Scroll {
            if-layers = <1 2>;
            then-layer = <5>;
        };
    };
};
