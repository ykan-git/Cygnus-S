#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt TAB Q           &kp W           &kp E         &kp R             &kp T                                                    &kp Y            &kp U  &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S           &kp D         &kp F             &kp G              &mo 4              &kp RIGHT_CONTROL  &kp H            &kp J  &kp K      &kp L    &kp BACKSPACE
&mt LEFT_SHIFT Z    &kp X           &kp C         &kp V             &kp B              &kp LC(SPACE)      &kp RIGHT_SHIFT    &kp N            &kp M  &kp COMMA  &kp DOT  &kp ENTER
&kp LCTRL           &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp RIGHT_COMMAND  &kp SPACE          &lt 7 MINUS        &lt 2 SEMICOLON                             &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        Number {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                           &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans      &trans      &kp N4  &kp N5  &kp N6  &kp PLUS   &kp MINUS
&kp F11  &kp F12  &trans  &trans  &trans   &trans      &trans      &kp N7  &kp N8  &kp N9  &kp ASTRK  &kp FSLH
&trans   &trans   &trans  &trans  &trans   &trans      &kp PERIOD  &kp N0                             &kp COMMA
            >;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                      &kp F6  &kp F7              &kp F8          &kp F9               &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_ARROW      &kp UP_ARROW    &kp RIGHT_ARROW      &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(LEFT_ARROW)  &kp DOWN_ARROW  &kp LG(RIGHT_ARROW)  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                           &trans
            >;
        };

        Move {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp N1  &kp N2          &kp UP_ARROW    &kp N3           &kp N4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp N5  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp N9
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp N0  &kp N1          &kp DOWN_ARROW  &kp N3           &kp N4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &kp N5
            >;
        };

        Settings {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans       &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                      &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans       &trans
&trans  &lt 5 SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &trans      &trans  &mkp MCLK  &mkp LCLK        &mkp MCLK          &lt 5 SPACE  &trans
&trans  &trans       &trans           &trans             &trans     &trans      &trans  &trans     &mkp MB4         &mkp MB5           &trans       &trans
&trans  &trans       &trans           &trans             &trans     &trans      &trans  &trans                                                      &trans
            >;
        };

        NUMSIGN {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3     &kp NUMBER_4     &kp N5                            &kp NUMBER_6  &kp N7                &kp N8            &kp N9             &kp N0
&trans        &kp ESCAPE       &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans      &trans  &kp EQUAL     &kp TILDE             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &trans      &trans  &kp SLASH     &kp NON_US_BACKSLASH  &kp SEMICOLON     &kp SINGLE_QUOTE   &trans
&trans        &trans           &trans           &trans           &trans        &trans      &trans  &trans                                                                   &trans
            >;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
